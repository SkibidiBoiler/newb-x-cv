     {190, 0x70013baa5c, 0, 0xbd000700, fix_grass_fade_quads, "grass quads: fade"},
+    {190, 0x700156f930, 0, 0x1e220822, fix_solver_cap, "physics: solver microsteps"},
 };
 int native_patch_c(Cpu *c, uint32_t i) { return fixes[i].fn(c); }
 
