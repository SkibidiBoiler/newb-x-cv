+PATCHES_190[0x70013a85d0] = _grass_fade_190(27, 0x240)
+PATCHES_190[0x70013baa5c] = _grass_fade_190(24, 0x4)
+PATCHES_190[0x70013c94ac] = _tree_ranges_190
+
