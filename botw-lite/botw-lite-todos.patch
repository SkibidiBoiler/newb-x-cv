     return 3;
 }
+float rt_solver_cap(float delta_frame, float per_frame);  // hle/physics_lite.c
+static int fix_solver_cap(Cpu *c) {
+    union { uint32_t u; float f; } d = {.u = (uint32_t)c->v[1]}, k = {.u = (uint32_t)c->v[2]};
+    k.f = rt_solver_cap(d.f, k.f);
+    c->v[2] = k.u;
+    return 3;
+}
