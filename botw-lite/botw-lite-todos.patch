+# v1.9.0, the physics step's solver microsteps (runtime/hle/physics_lite.c rt_solver_cap; the site from
+# SavageWindRecomp's tools/game_sites.py, MIT): s2 = delta frame (s1) x 6 (s2), capped there.
+def _solver_cap_190(gen, a):
+    w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
