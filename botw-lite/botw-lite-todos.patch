new file mode 100644
index 0000000..87b0fb5
--- /dev/null
+++ b/runtime/sampler.c
@@ -0,0 +1,224 @@
+// Sampling profiler of the game's threads, on the phone itself (no adb, no simpleperf): where their CPU time goes.
+// LARECOMP_SAMPLE=<from>:<to> - presented frames, as LARECOMP_FNPROF. Each game thread (kernel.c thread_main) gets a
+// timer on its own CPU time (asked for every millisecond it runs - the kernel checks CPU timers at its tick, so ~250
+// a second at HZ=250; a thread that waits costs nothing), whose SIGPROF
+// notes the interrupted pc and lr. At frame <to> they are written to build/samples.txt (LARECOMP_SAMPLE_OUT), per
+// thread, as the game's functions:
+// - Recompiled: the pc in botwgame.so, mapped back through its tables (gamelib.h) to f_<guest address>, the names
+//   fnprof.txt and the generated code use (main at 0x7000000000).
+// - Native: the pc is the game's own, at its guest address: main+<offset>, the same 0x7000000000 naming.
+// fnprof only counts entries (a small function called a million times looks hot); this is time.
+// Only addresses and counts, nothing of the game: the file can go with a report.
+#define _GNU_SOURCE
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include "gamelib.h"
+#include "rt.h"
+
+#define NSAMPLE (1 << 20)  // (~16 min of one busy thread at 1 kHz; later samples are dropped)
+typedef struct { uint64_t pc, lr; uint32_t tid; } Sample;
+static Sample *g_buf;
+static atomic_uint g_n;
+static atomic_int g_on;
+static int g_from = -2, g_to;
+
+#define NTHREAD 128
+static struct { uint32_t tid; uint64_t id; } g_threads[NTHREAD];
+static atomic_int g_nthreads;
+
+static void on_prof(int sig, siginfo_t *si, void *ctx) {
+    (void)sig, (void)si;
+    if (!atomic_load_explicit(&g_on, memory_order_relaxed)) return;
+    unsigned i = atomic_fetch_add_explicit(&g_n, 1, memory_order_relaxed);
+    if (i >= NSAMPLE) return;
+#if defined(__aarch64__)
+    const ucontext_t *uc = ctx;
+    g_buf[i].pc = uc->uc_mcontext.pc;
+    g_buf[i].lr = uc->uc_mcontext.regs[30];
+#else
+    (void)ctx;
+    g_buf[i].pc = g_buf[i].lr = 0;
+#endif
+    g_buf[i].tid = (uint32_t)syscall(SYS_gettid);
+}
+
+static bool sampler_enabled(void) {
+    if (g_from == -2) {
+        g_from = -1;
+        const char *e = getenv("LARECOMP_SAMPLE");
+        if (e && (sscanf(e, "%d:%d", &g_from, &g_to) != 2 || g_to <= g_from)) g_from = -1;
+        if (g_from >= 0) {
+            g_buf = mmap(NULL, sizeof(Sample) * NSAMPLE, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+            if (g_buf == MAP_FAILED) g_buf = NULL, g_from = -1;
+            struct sigaction sa = {0};
+            sa.sa_sigaction = on_prof;
+            sa.sa_flags = SA_SIGINFO | SA_RESTART;
+            sigemptyset(&sa.sa_mask);
+            if (g_buf) sigaction(SIGPROF, &sa, NULL);
+            LOG("[sample] frames %d-%d: %s\n", g_from, g_to, g_buf ? "armed" : "no memory, off");
+        }
+    }
+    return g_from >= 0;
+}
+
+// A game thread starts (kernel.c thread_main; id: the game's thread id, the t<N> of the logs)
+void sampler_thread_start(uint64_t id) {
+    static atomic_flag lock = ATOMIC_FLAG_INIT;  // (the first call arms it; threads start one by one anyway)
+    while (atomic_flag_test_and_set(&lock)) {}
+    bool on = sampler_enabled();
+    atomic_flag_clear(&lock);
+    if (!on) return;
+    uint32_t tid = (uint32_t)syscall(SYS_gettid);
+    int k = atomic_fetch_add(&g_nthreads, 1);
+    if (k < NTHREAD) g_threads[k].tid = tid, g_threads[k].id = id;
+    struct sigevent sev = {0};
+    sev.sigev_notify = SIGEV_THREAD_ID;
+    sev.sigev_signo = SIGPROF;
+#ifdef sigev_notify_thread_id
+    sev.sigev_notify_thread_id = (pid_t)tid;
+#else
+    sev._sigev_un._tid = (pid_t)tid;
+#endif
+    timer_t t;
+    if (timer_create(CLOCK_THREAD_CPUTIME_ID, &sev, &t)) {
+        LOG("[sample] t%llu: no timer\n", (unsigned long long)id);
+        return;
+    }
+    struct itimerspec its = {{0, 1000000}, {0, 1000000}};  // (1 ms of the thread's own CPU time)
+    timer_settime(t, 0, &its, NULL);
+}
+
+// ---- the report
+typedef struct { uintptr_t host; uint64_t guest; } FnMap;
+static FnMap *g_map;
+static size_t g_nmap;
+static int cmp_host(const void *a, const void *b) {
+    uintptr_t x = ((const FnMap *)a)->host, y = ((const FnMap *)b)->host;
+    return x < y ? -1 : x > y;
+}
+static void build_map(void) {
+    const GameLibTables *t = gamelib_tables();
+    if (!t) return;
+    size_t nm = *t->main_count, ns = *t->sdk_count;
+    g_map = malloc(sizeof(FnMap) * (nm + ns));
+    if (!g_map) return;
+    for (size_t i = 0; i < nm; i++)
+        if (t->main_fns[i]) g_map[g_nmap++] = (FnMap){(uintptr_t)t->main_fns[i], t->main_addrs[i]};
+    for (size_t i = 0; i < ns; i++)
+        if (t->sdk_fns[i]) g_map[g_nmap++] = (FnMap){(uintptr_t)t->sdk_fns[i], t->sdk_addrs[i]};
+    qsort(g_map, g_nmap, sizeof *g_map, cmp_host);
+}
+// A pc as the game function it is in: f_<guest address> (0: neither the game library nor guest code)
+static uint64_t pc_guest(uint64_t pc) {
+    if (pc >= MAIN_BASE && pc < MAIN_BASE + 0x10000000ull)  // (native: the game's own code at its guest address)
+        return pc - MAIN_BASE + 0x7000000000ull;
+    if (!g_nmap || pc < g_map[0].host) return 0;
+    size_t lo = 0, hi = g_nmap;
+    while (hi - lo > 1) {
+        size_t mid = (lo + hi) / 2;
+        if (g_map[mid].host <= pc) lo = mid; else hi = mid;
+    }
+    if (pc - g_map[lo].host > 0x100000) return 0;  // (past the game code: the runtime's)
+    return g_map[lo].guest;
+}
+
+typedef struct { uint64_t key, key2; uint32_t count; } Row;
+static int cmp_count(const void *a, const void *b) {
+    uint32_t x = ((const Row *)a)->count, y = ((const Row *)b)->count;
+    return x < y ? 1 : x > y ? -1 : 0;
+}
+static int cmp_key(const void *a, const void *b) {
+    const Row *x = a, *y = b;
+    if (x->key != y->key) return x->key < y->key ? -1 : 1;
+    return x->key2 < y->key2 ? -1 : x->key2 > y->key2;
+}
+// rows (key, key2) counted: sorted by key, then merged, then by count
+static size_t tally(Row *r, size_t n) {
+    qsort(r, n, sizeof *r, cmp_key);
+    size_t m = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (m && r[m - 1].key == r[i].key && r[m - 1].key2 == r[i].key2) r[m - 1].count += r[i].count;
+        else r[m++] = r[i];
+    }
+    qsort(r, m, sizeof *r, cmp_count);
+    return m;
+}
+
+static void sampler_write(void) {
+    unsigned n = atomic_load(&g_n);
+    if (n > NSAMPLE) n = NSAMPLE;
+    build_map();
+    const char *out = getenv("LARECOMP_SAMPLE_OUT") ? getenv("LARECOMP_SAMPLE_OUT") : "build/samples.txt";
+    FILE *f = fopen(out, "w");
+    if (!f) { LOG("[sample] cannot write %s\n", out); return; }
+    fprintf(f, "# BOTWRecompAndroid samples of each game thread's CPU time (1 ms timer, at the kernel's tick), frames %d-%d\n", g_from, g_to);
+    fprintf(f, "# game_version %d\n# mode %s\n# samples %u\n", g_game_version, g_nmap ? "recompiled" : "native", n);
+    Row *r = malloc(sizeof(Row) * (n ? n : 1));
+    int nt = atomic_load(&g_nthreads);
+    if (nt > NTHREAD) nt = NTHREAD;
+    // per thread: its samples, and how many fell in the game's code (the rest: the runtime, the kernel's services)
+    fprintf(f, "\n## threads (id tid samples in_game)\n");
+    for (int k = 0; k < nt && r; k++) {
+        unsigned s = 0, g = 0;
+        for (unsigned i = 0; i < n; i++)
+            if (g_buf[i].tid == g_threads[k].tid) s++, g += pc_guest(g_buf[i].pc) != 0;
+        if (s) fprintf(f, "t%llu %u %u %u\n", (unsigned long long)g_threads[k].id, g_threads[k].tid, s, g);
+    }
+    // per thread, its top functions (key: tid, key2: function)
+    for (int k = 0; k < nt && r; k++) {
+        size_t m = 0;
+        unsigned total = 0;
+        for (unsigned i = 0; i < n; i++)
+            if (g_buf[i].tid == g_threads[k].tid) r[m++] = (Row){0, pc_guest(g_buf[i].pc), 1}, total++;
+        if (total < 50) continue;
+        m = tally(r, m);
+        fprintf(f, "\n## t%llu: top functions (function samples %%; f_0: outside the game code)\n",
+                (unsigned long long)g_threads[k].id);
+        for (size_t i = 0; i < m && i < 150; i++)
+            fprintf(f, "f_%llx %u %.2f\n", (unsigned long long)r[i].key2, r[i].count, 100.0 * r[i].count / total);
+        // (and the top 25 in the log too: Settings > Files > Save a log file sends them, no Android/data to dig in)
+        LOG("[sample] t%llu: %u samples, top:", (unsigned long long)g_threads[k].id, total);
+        for (size_t i = 0; i < m && i < 25; i++)
+            LOG(" f_%llx %.1f%%", (unsigned long long)r[i].key2, 100.0 * r[i].count / total);
+        LOG("\n");
+    }
+    // every thread: function <- its caller (from lr), the context of the hot ones
+    if (r) {
+        size_t m = 0;
+        for (unsigned i = 0; i < n; i++) {
+            uint64_t fn = pc_guest(g_buf[i].pc);
+            if (fn) r[m++] = (Row){fn, pc_guest(g_buf[i].lr), 1};
+        }
+        m = tally(r, m);
+        fprintf(f, "\n## all game threads: function caller samples\n");
+        for (size_t i = 0; i < m && i < 300; i++)
+            fprintf(f, "f_%llx f_%llx %u\n", (unsigned long long)r[i].key, (unsigned long long)r[i].key2, r[i].count);
+    }
+    free(r);
+    fclose(f);
+    LOG("[sample] %u samples of %d threads, written %s\n", n, nt, out);
+}
+
+// Each presented frame (nvn/vulkan/device.c, beside fnprof_frame)
+void sampler_frame(uint64_t frame) {
+    if (g_from < 0) return;
+    if ((int64_t)frame == g_from) {
+        atomic_store(&g_n, 0);
+        atomic_store(&g_on, 1);
+        LOG("[sample] on at frame %llu\n", (unsigned long long)frame);
+    } else if ((int64_t)frame == g_to && atomic_load(&g_on)) {
+        atomic_store(&g_on, 0);
+        sampler_write();
+        g_from = -1;
+    }
+}
