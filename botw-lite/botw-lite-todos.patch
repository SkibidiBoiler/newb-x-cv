-#ifdef BOTW_LITE
-    if (!e) e = "1";  // (the Lite build: always off the little cores)
-#endif
-    if (e && !atoi(e)) return;
+// The cores of at least half the strongest's capacity (forced and nothing under half: every core but the slowest
+// cluster - only top clocks to go by, the 778G's A55s at 1.9 GHz against 2.4). Returns how many, 0 when there's
+// nothing to pick (one cluster) or, unforced, no little cores. *little: the CPU has them.
+static int big_core_set(cpu_set_t *set, bool forced, bool *little_out) {
     long best = 0, weakest = 0, cap[64] = {0};
     int n = 0;
     for (int c = 0; c < 64; c++) {
@@ -918,30 +916,64 @@ void plat_render_thread_pin(void) {
         if (!weakest || cap[c] < weakest) weakest = cap[c];
