 runtime/hle/physics_lite.c | 30 ++++++++++++++++++++++++++++++
 runtime/native.c           |  8 ++++++++
 runtime/settings.c         |  6 +++++-
 runtime/settings.h         |  1 +
 tools/patches.py           | 11 +++++++++++
 5 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 runtime/hle/physics_lite.c

diff --git a/runtime/hle/physics_lite.c b/runtime/hle/physics_lite.c
new file mode 100644
index 0000000..aae4383
--- /dev/null
+++ b/runtime/hle/physics_lite.c
@@ -0,0 +1,30 @@
+// Physics > Solver steps (Settings.solver_cap; LARECOMP_SOLVER_CAP=<n>, 0: the game's): before each Havok step 1.9.0
+// gives the solver round(delta frame x 6) microsteps (0x700156f930; the site from SavageWindRecomp, Revivedx, MIT:
+// tools/game_sites.py phys_solver_steps). 6 at 30 fps - and 9 at 20 fps: a frame of the Lite build's 20 fps mode does
+// half as much solver work again as a console frame, all of it on the game's own threads. At most <n> here: 6 keeps the
+// console's count per step. Fewer than 6 gives way in contacts (SavageWindRecomp's tests: holding a cucco, Link's jump
+// 0.42 m with 4 against ~0.55 with 6), so the cap is never under 6.
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "../hle.h"
+#include "../rt.h"
+#include "../settings.h"
+
+float rt_solver_cap(float delta_frame, float per_frame) {
+    static int env = -2;
+    if (env == -2) {
+        const char *e = getenv("LARECOMP_SOLVER_CAP");
+        env = e ? atoi(e) : -1;
+    }
+    int cap = env >= 0 ? env : g_settings.solver_cap;
+    float steps = delta_frame * per_frame;
+    if (cap <= 0) return steps;  // (the game's own)
+    if (cap < 6) cap = 6;
+    static int logged;
+    if (steps > (float)cap && !logged) {
+        logged = 1;
+        LOG("[physics] solver microsteps %.1f a step -> %d (delta frame %.2f)\n", steps, cap, delta_frame);
+    }
+    return steps > (float)cap ? (float)cap : steps;
+}
