+# v1.9.0, World detail (runtime/hle/world_detail.c; the sites from SavageWindRecomp's tools/game_sites.py, MIT): the
+# placed actors' traverse distance scale (from the actor debug manager at +0x310, or 1.0 without it - the released
+# game), the grass blades' view region and both grass layers' fades, the terrain's distant trees. Each returns the
+# game's own values while the setting is 1.
+def _traverse_scale_190(gen, a):
+    w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
+    assert w == 0xbd431101, hex(w)  # ldr s1, [x8, #0x310]
+    return ('{ extern uint32_t rt_traverse_scale(uint32_t, uint32_t); '
+            'c->v[1] = rt_traverse_scale(LD32(c->x[8] + 0x310), (uint32_t)c->v[0]); }'
+            f'  /* {a:#x}: ldr s1, [x8, #0x310] (actors: traverse distance scale; tools/patches.py) */')
+
+
+def _traverse_scale_default_190(gen, a):
+    w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
+    assert w == 0x1e2e1001, hex(w)  # fmov s1, #1.0
+    return ('{ extern uint32_t rt_traverse_scale(uint32_t, uint32_t); '
+            'c->v[1] = rt_traverse_scale(0x3f800000u, (uint32_t)c->v[0]); }'
+            f'  /* {a:#x}: fmov s1, #1.0 (actors: traverse distance scale; tools/patches.py) */')
+
+
+def _grass_range_190(gen, a):
+    w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
+    assert w == 0xbd400024, hex(w)  # ldr s4, [x1]
+    return ('{ extern int rt_grass_range(uint64_t, uint32_t, uint32_t *, uint32_t *, uint32_t *); '
+            'uint32_t s0 = (uint32_t)c->v[0], s1 = (uint32_t)c->v[1], s2 = (uint32_t)c->v[2]; '
+            'if (rt_grass_range(c->x[2], (uint32_t)c->v[3], &s0, &s1, &s2)) { c->v[0] = s0; c->v[1] = s1; c->v[2] = s2; } '
+            'c->v[4] = LD32(c->x[1]); }'
+            f'  /* {a:#x}: ldr s4, [x1] (grass: view region; tools/patches.py) */')
+
+
+def _grass_fade_190(base, off):
+    def patch(gen, a):
+        w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
+        assert w == 0xbd000000 | ((off // 4) << 10) | (base << 5), hex(w)  # str s0, [x<base>, #off]
+        return ('{ extern uint32_t rt_grass_fade(uint32_t); '
+                f'ST32(c->x[{base}] + {off:#x}, rt_grass_fade((uint32_t)c->v[0])); }}'
+                f'  /* {a:#x}: str s0, [x{base}, #{off:#x}] (grass: fade scale; tools/patches.py) */')
+    return patch
+
+
+def _tree_ranges_190(gen, a):
+    w = struct.unpack_from('<I', gen.nso.image, a - gen.base)[0]
+    assert w & 0x9f00001f == 0x90000008, hex(w)  # adrp x8, <page>
+    imm = ((w >> 29) & 3) | (((w >> 5) & 0x7ffff) << 2)
+    if imm & (1 << 20):
+        imm -= 1 << 21
+    page = (a & ~0xfff) + (imm << 12)
+    return (f'{{ extern void rt_tree_ranges(uint64_t); rt_tree_ranges(c->x[0]); c->x[8] = {page:#x}ull; }}'
+            f'  /* {a:#x}: adrp x8, {page:#x} (distant trees: ranges; tools/patches.py) */')
+
+
+PATCHES_190[0x70010a4674] = _traverse_scale_190
