From 52416ba3d642e34f67f702ec931310efe51df13a Mon Sep 17 00:00:00 2001
From: BOTW perf <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 00:01:08 +0000
Subject: [PATCH 3/7] Android: the game's threads on the big cores
 (LARECOMP_GAME_BIG, on in Lite)

Core 0 runs one thread at a time (the main thread and its job workers take turns), so any of them on a
little core holds the frame up. Every game thread now goes to the same big-core set, keeping their speeds
alike (unlike LARECOMP_PIN). The render pin shares the big-core selection.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EvHfzrxmgqUumCfN8U5uyT
---
 runtime/kernel.c           |  1 +
 runtime/platform.h         |  1 +
 runtime/platform/android.c | 83 +++++++++++++++++++++++++++-----------
 3 files changed, 61 insertions(+), 24 deletions(-)

diff --git a/runtime/kernel.c b/runtime/kernel.c
index 55da188..76c40e1 100644
--- a/runtime/kernel.c
+++ b/runtime/kernel.c
@@ -369,6 +369,7 @@ static void *thread_main(void *arg) {
     t_cur = t;
 #ifdef __ANDROID__
     plat_thread_unpin();  // (not the presenting thread's fast cores: platform.h)
+    plat_game_thread_big();  // (LARECOMP_GAME_BIG / the Lite build: the game's threads off the little cores)
 #endif
     crash_handler_install();
     rt_set_fpcr(0);
diff --git a/runtime/platform.h b/runtime/platform.h
index ee9a9c4..5a1db26 100644
--- a/runtime/platform.h
+++ b/runtime/platform.h
@@ -109,6 +109,7 @@ void plat_adpf_stats(PlatAdpfStats *out);
 // A new thread back on every core: threads inherit the creating thread's affinity, and the presenting thread is
 // pinned to the fastest cores (platform/android.c)
 void plat_thread_unpin(void);
+void plat_game_thread_big(void);  // (Android: LARECOMP_GAME_BIG, the game's threads on the big cores)
 #endif
 #endif
 
diff --git a/runtime/platform/android.c b/runtime/platform/android.c
index 61dd9b4..9116d88 100644
