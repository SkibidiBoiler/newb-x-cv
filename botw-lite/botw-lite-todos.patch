 runtime/platform/android.c | 61 ++++++++++++++++++++++++++++----------
 runtime/settings.c         |  4 ++-
 runtime/settings.h         |  3 ++
 4 files changed, 75 insertions(+), 16 deletions(-)

diff --git a/runtime/hle/widescreen.c b/runtime/hle/widescreen.c
index 1b5439f..48bd474 100644
--- a/runtime/hle/widescreen.c
+++ b/runtime/hle/widescreen.c
@@ -17,6 +17,7 @@
 #include <stdbool.h>
 #include <stdint.h>
 
+#include <stdlib.h>
 #include <string.h>
 
 #include "../framepace.h"
@@ -73,8 +74,30 @@ uint32_t rt_aspect_bits(int site) {
 static volatile bool g_widened;  // (rt_persp_update has widened a camera)
 static bool is_16_9(float a) { return a > 1.7767f && a < 1.7789f; }
 RT_ON_RESET(widescreen_reset) { g_boot_aspect = -1, g_hooked = false, g_widened = false; }  // (Return to start: a new boot)
+// Draw distance (Settings.draw_distance / LARECOMP_FAR=<metres>): the main camera's far plane (25000, the one
+// projection that far: the others are the shadows', the HUD's, the UI's) brought nearer before its matrix is built,
+// so the game's own frustum culling drops what lies past it. The game keeps the field, so it is set once and stays;
+// a later reset to 25000 is caught again here. Experimental: the horizon ends at that distance (the fog hides some
+// of it); terrain and actors nearer keep their own level of detail.
+static void persp_far(uint64_t proj) {
+    static int env = -1;
+    if (env < 0) {
+        const char *e = getenv("LARECOMP_FAR");
+        env = e && atoi(e) > 0 ? atoi(e) : 0;
+    }
+    int want = env ? env : g_settings.draw_distance;
+    if (want <= 0) return;
+    if (want < 1000) want = 1000;  // (nearer, the world's own map tiles vanish in front of Link)
+    float *far = (float *)(uintptr_t)(proj + 0x9C);
+    if (*far < 20000.0f || *far <= (float)want) return;
+    static int n;
+    if (n++ < 4) LOG("[drawdist] projection %llx: far %.0f -> %d\n", (unsigned long long)proj, *far, want);
+    *far = (float)want;
+}
+
 void rt_persp_update(uint64_t proj) {
     g_hooked = true;
+    if (proj) persp_far(proj);
     if (!proj || !widescreen_allowed() || g_shape <= 1.001f) return;
     float *aspect = (float *)(uintptr_t)(proj + 0xB0);
     if (ENV("LARECOMP_LOG_ASPECT")) {  // (each projection rebuilt, once: near, far, fovy, aspect)
