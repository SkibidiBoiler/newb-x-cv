index 6337ade..f373a4c 100644
--- a/runtime/platform/android.c
+++ b/runtime/platform/android.c
@@ -872,37 +872,68 @@ static void uclamp_min_thread(void) {
         LOG("[android] uclamp.min %d for the game's threads: %s\n", want, r ? strerror(errno) : "ok");
 }
 
-// The render thread (vulkan/async.c, ours: no part of the game's job system that LARECOMP_PIN broke) on the fastest
+// The render thread (vulkan/async.c, ours: no part of the game's job system that LARECOMP_PIN broke) off the little
 // cores. Left to the scheduler on a Galaxy Tab A9+ (Snapdragon 695: 2 x A78, 6 x A55) it sat on a little core,
-// 90 ms a frame translating the world, while the game's thread had a big one (2026-11-08). Default: on low RAM
-// (vulkan/exec.c vk_low_ram - the weak phones); LARECOMP_RENDER_BIG=1 / 0.
+// 90 ms a frame translating the world, while the game's thread had a big one (2026-11-08). The same layout on the
+// Snapdragon 778G / 7-series (1 + 3 x A78, 4 x A55): a phone with 8 GB is no "low RAM" device, so the pin stayed off.
+// Default: on low RAM (vulkan/exec.c vk_low_ram) or wherever the CPU has little cores - a core whose capacity
+// (/sys/.../cpu_capacity, else its top clock) is under half the strongest's; the Snapdragon 8 Elite's middle cores are
+// ~80% of its prime ones, so nothing changes there. The set: every core of at least half the strongest's capacity
+// (the A78s, not only the one prime). LARECOMP_RENDER_BIG=1 / 0 forces it on / off.
+static long cpu_strength(int c) {
+    char path[96];
+    long v = 0;
+    snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpu_capacity", c);
+    FILE *f = fopen(path, "re");
+    if (f) {
+        if (fscanf(f, "%ld", &v) != 1) v = 0;
+        fclose(f);
+    }
+    if (v > 0) return v;
+    snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", c);
+    f = fopen(path, "re");
+    if (!f) return 0;
+    if (fscanf(f, "%ld", &v) != 1) v = 0;
+    fclose(f);
+    return v;
+}
+
 void plat_render_thread_pin(void) {
     const char *e = getenv("LARECOMP_RENDER_BIG");
-    extern bool vk_low_ram(void);
-    if (e ? !atoi(e) : !vk_low_ram()) return;
-    long best = 0, mhz[64] = {0};
+    if (e && !atoi(e)) return;
+    long best = 0, weakest = 0, cap[64] = {0};
     int n = 0;
     for (int c = 0; c < 64; c++) {
-        char path[96];
-        snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", c);
-        FILE *f = fopen(path, "re");
-        if (!f) continue;
-        if (fscanf(f, "%ld", &mhz[c]) != 1) mhz[c] = 0;
-        fclose(f);
-        if (mhz[c] > best) best = mhz[c];
+        cap[c] = cpu_strength(c);
+        if (!cap[c]) continue;
+        if (cap[c] > best) best = cap[c];
+        if (!weakest || cap[c] < weakest) weakest = cap[c];
         n = c + 1;
     }
+    extern bool vk_low_ram(void);
+    bool little = best && weakest * 2 < best;
+    if (!e && !vk_low_ram() && !little) return;
     cpu_set_t set;
     CPU_ZERO(&set);
     int k = 0;
     for (int c = 0; c < n; c++)
-        if (mhz[c] == best) {
+        if (cap[c] && cap[c] * 2 >= best) {
             CPU_SET(c, &set);
             k++;
         }
+    if (e && k == n && weakest < best) {  // (forced, no core under half: e.g. only top clocks to go by, the 778G's
+        CPU_ZERO(&set);                    //  A55s at 1.9 GHz against 2.4 - every core but the slowest cluster)
+        k = 0;
+        for (int c = 0; c < n; c++)
+            if (cap[c] > weakest) {
+                CPU_SET(c, &set);
+                k++;
+            }
+    }
     if (!best || k == 0 || k == n) return;
     int r = sched_setaffinity(0, sizeof set, &set);
-    LOG("[android] render thread on the %d fastest cores (%ld MHz): %s\n", k, best / 1000, r ? strerror(errno) : "ok");
+    LOG("[android] render thread on the %d big cores (capacity >= %ld of %ld%s): %s\n", k, (best + 1) / 2, best,
+        little ? ", little cores present" : "", r ? strerror(errno) : "ok");
 }
 
 void plat_thread_unpin(void) {
