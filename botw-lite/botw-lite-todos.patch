@@ -0,0 +1,94 @@
+// Video > World detail (Settings.actor_distance; LARECOMP_ACTOR_DIST=<factor>): how far from the camera 1.9.0 keeps
+// the actors placed on the map, makes its grass and draws its distant trees - for weak phones, where the game's own
+// thread (the actors it updates) and the render thread (the draws) are the limit. 1 (or 0 in the ini): the game's
+// own values, bit for bit.
+//
+// The sites and what they mean come from SavageWindRecomp (Revivedx, MIT: tools/game_sites.py, tools/patches.py,
+// runtime/draw_distance.c), whose Potato preset measured fewer actors as more fps on a 4-core PC (0.6 of the game's
+// distances: Rito Village 101 -> 120 fps, Kakariko 148 -> 159). This is this port's own, smaller take, nearer only:
+// - Placed actors (1.9.0 0x70010a4674 / 0x70010a4694): every one exists only within its traverse distance of the
+//   camera, its ActorInfo traverseDist (100 m when unset) times a scale that is 1 in the released game. The scale is
+//   multiplied here: the game itself makes fewer actors, with its own rules. Far models (a distance of FAR_DIST m or
+//   more: "_Far" buildings, the castle, the mountains' rocks) take a milder factor, so the horizon keeps its shapes.
+// - Grass (0x70013ad8b0, the blades' view region; 0x70013a85d0 / 0x70013baa5c, each layer's fade): fewer cells made
+//   and drawn, fading out nearer.
+// - The terrain's distant trees (0x70013c94ac, Recompiled mode only: its site is a PC-relative adrp): their ranges
+//   at +0x14cb0 times the far factor.
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../hle.h"
+#include "../rt.h"
+#include "../settings.h"
+
+#define FAR_DIST 2000.0f
+#define MIN_FACTOR 0.4f  // (nearer, Link's own surroundings thin out: enemies and trees appear a few metres away)
+
+static float bits_f(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+static uint32_t f_bits(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+
+float world_detail_factor(void) {
+    static float env = -1;
+    if (env < 0) {
+        const char *e = getenv("LARECOMP_ACTOR_DIST");
+        env = e ? (float)atof(e) : 0;
+    }
+    float f = env > 0 ? env : g_settings.actor_distance;
+    if (!(f > 0) || f >= 1.0f) return 1.0f;  // (more than the game's isn't offered here: weak phones)
+    return f < MIN_FACTOR ? MIN_FACTOR : f;
+}
+// The far models' and the distant trees': halfway between the game's and the actors' factor
+static float far_factor(void) { return 0.5f + 0.5f * world_detail_factor(); }
+
+// the traverse distance scale (float bits) as the game has it, and the actor's own distance (float bits; 0 or less:
+// the game takes 100) -> the scale to use
+uint32_t rt_traverse_scale(uint32_t scale, uint32_t dist) {
+    float f = world_detail_factor();
+    if (f == 1.0f) return scale;
+    float s = bits_f(scale), d = bits_f(dist);
+    float game = (d > 0 ? d : 100.0f) * s;
+    static int logged;
+    if (!logged) logged = 1, LOG("[world] actors at %.2f of the game's distances, far models %.2f\n", f, far_factor());
+    return f_bits(s * (game >= FAR_DIST ? far_factor() : f));
+}
+
+// a grass layer's fade scale (float bits; its fades go as 1 / (k * distance)) as the game stores it once a frame ->
+// the one to store: k / factor, so the grass fades out that much nearer
+uint32_t rt_grass_fade(uint32_t k) {
+    float f = world_detail_factor();
+    return f == 1.0f ? k : f_bits(bits_f(k) / f);
+}
+
+// the grass's view context (cam: x2, cell: s3 the layer's cell size): s0 the least tan(fovy / 2) it takes, s1 / s2 its
+// screen-size limits (float bits). The region the blades (3 m cells) make cells in reaches about
+// 1 / (max(tan, s0) * s1): the limits over the factor bring it nearer, and s0 times it keeps the narrowest view's
+// reach (1 / (s0 * s1)) where the game has it. The crossed quads (10 m) keep their region: their fade does it.
+int rt_grass_range(uint64_t cam, uint32_t cell, uint32_t *s0, uint32_t *s1, uint32_t *s2) {
+    (void)cam;
+    float f = world_detail_factor();
+    if (f == 1.0f || fabsf(bits_f(cell) - 3.0f) > 0.01f) return 0;
+    *s0 = f_bits(bits_f(*s0) * f);
+    *s1 = f_bits(bits_f(*s1) / f);
+    *s2 = f_bits(bits_f(*s2) / f);
+    return 1;
+}
+
+// the terrain's distant trees (x0 of their per-frame shader setup): their five ranges at +0x14cb0 (fade in, its
+// length, the end, the fade out, where their blocks change detail), the game's latest values times the far factor.
+// The game writes them again as it plays, so values that aren't the ones last set here are its new ones.
+void rt_tree_ranges(uint64_t tree) {
+    float f = world_detail_factor();
+    if (f == 1.0f || !tree) return;
+    f = far_factor();
+    static struct { uint64_t obj; float set[5]; } seen[8];
+    float *r = (float *)(uintptr_t)(tree + 0x14cb0);
+    int i = 0;
+    while (i < 8 && seen[i].obj && seen[i].obj != tree) i++;
+    if (i == 8) i = 7;  // (more than 8 tree objects: the last slot is shared, each one scaled from its own values)
+    bool known = seen[i].obj == tree;
+    seen[i].obj = tree;
+    for (int k = 0; k < 5; k++)  // (each value on its own: one the game wrote again is scaled, the others stay)
+        if (!known || r[k] != seen[i].set[k]) seen[i].set[k] = r[k] = r[k] * f;
+}
