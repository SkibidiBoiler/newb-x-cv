+    return ('{ extern float rt_solver_cap(float, float); union { uint32_t u; float f; } d = { .u = (uint32_t)c->v[1] }, '
+            'k = { .u = (uint32_t)c->v[2] }; k.f = rt_solver_cap(d.f, k.f); c->v[2] = k.u; }'
+            f'  /* {a:#x}: fmul s2, s1, s2 (physics: solver microsteps; tools/patches.py) */')
+
